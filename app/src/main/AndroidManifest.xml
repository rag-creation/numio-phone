<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission: Phone by Numio never goes online.
         Each permission is asked for only when it's needed (see README). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Recents and Contacts tabs: asked for only when you tap Allow there -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Delete calls from Recents: asked the first time you delete one -->
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <!-- Add, edit and delete contacts: asked the first time you press Save -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Lets Android hand missed calls to this app, so it can show its own
         missed-call notification with Call back and Message buttons -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Turns the screen off when the phone is at your ear during a call -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhonebyNumio">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Required to be the default phone app -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- Ringing and on-a-call screen, shown over the lock screen -->
        <activity
            android:name=".call.CallActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity="com.rr.numio.phone.call"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait" />

        <!-- Android binds this when Phone by Numio is the default phone app -->
        <service
            android:name=".telecom.CallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".telecom.CallActionReceiver"
            android:exported="false" />

        <!-- Blocking rules (hidden numbers, unknown callers, country codes), asked by
             Android before an incoming call rings. Only Android can bind it. -->
        <service
            android:name=".telecom.ScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Missed calls from Android. Starts off; switched on once phone-state access
             is granted (see MissedCalls), so Android's own notification shows until then. -->
        <receiver
            android:name=".telecom.MissedCalls$Receiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
